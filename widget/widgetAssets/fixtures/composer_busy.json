                "turn_id": "t-composer-busy",
                "contract_version": "2.8.0",
                "stop_reason": "end_turn",
                "transcript": [
                    {
                        "type": "text",
                        "text": "Here is the summary of the case."
                    }
                ]
            }
        }
    ]
}
